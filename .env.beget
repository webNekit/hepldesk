# ============================================================
#  Продакшн-окружение для Beget (деплой через git без SSH)
#  На сервере скопируйте этот файл в .env (через Файловый менеджер Beget)
#  и подставьте свой домен в APP_URL.
# ============================================================

APP_NAME="Helpdesk"
APP_ENV=production
APP_KEY=base64:5NgkRcF7ecgze8DKvKFZop58TUEJc6aIwUJ9Jom/Urw=
APP_DEBUG=false

# ВАЖНО: укажите реальный адрес сайта (с https, если подключён SSL)
APP_URL=https://your-domain.beget.tech

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# В проде логируем только ошибки
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- База данных: SQLite ---
# Файл database/database.sqlite приезжает вместе с репозиторием.
# Можно оставить пустым DB_DATABASE (Laravel сам возьмёт database/database.sqlite),
# либо указать абсолютный путь, если так удобнее:
# DB_DATABASE=/home/ЛОГИН/ДОМЕН/public_html/database/database.sqlite
DB_CONNECTION=sqlite

# Сессии и кэш — через ту же SQLite (таблицы уже есть в файле БД)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Без SSH воркер очереди не запустить — выполняем задачи синхронно
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log

FILESYSTEM_DISK=local
CACHE_STORE=database

# Почта не настроена — письма пишутся в лог. Подставьте SMTP при необходимости.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@your-domain.ru"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
